# Copy this file to japan2026/.env and fill in real values.
# All variables must be prefixed with VITE_ to be exposed to the browser bundle.

# Mapbox public token — https://account.mapbox.com/
# Used when MAP_PROVIDER === 'mapbox' in shared/data/mapConfig.js.
VITE_MAPBOX_TOKEN=

# Google Maps JavaScript API key — https://console.cloud.google.com/google/maps-apis
# Restrict by HTTP referrer in Cloud Console. Enable: Maps JavaScript API + Places API (New).
# NOTE: this is intentionally `VITE_GOOGLE_MAP` (not `..._API_KEY`) — keep the name.
VITE_GOOGLE_MAP=

# Google Maps Map ID — required for AdvancedMarkerElement (the modern, non-deprecated marker).
# Create at https://console.cloud.google.com/google/maps-apis/studio/maps
#   1. New Map ID  -> Map type: JavaScript -> Save
#   2. (Optional) Attach a map style to the Map ID for custom appearance.
#   3. Copy the Map ID and paste below as VITE_GOOGLE_MAP_ID=<your-id>.
# If left blank, the app falls back to Google's DEMO_MAP_ID (works for dev, default styling,
# rate-limited) and logs a console warning.
VITE_GOOGLE_MAP_ID=
